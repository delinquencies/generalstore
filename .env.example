# Optional. Use the confirmed public origin once available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional local Medusa catalog. Set all three to enable it.
# MEDUSA_BACKEND_URL=http://127.0.0.1:9000
# MEDUSA_PUBLISHABLE_KEY=
# MEDUSA_REGION_ID=

# Optional local bag shipping estimates. Set these in the preview process
# environment or start with node --env-file=.env.local scripts/preview-plain.mjs.
# Use a Shippo test token first. The token and origin stay on the server.
# SHIPPO_API_TOKEN=
# SHIPPO_FROM_STREET=
# SHIPPO_FROM_CITY=
# SHIPPO_FROM_STATE=
# SHIPPO_FROM_ZIP=77521
